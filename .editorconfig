root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,ts,js,mjs,md,sql,rules}]
indent_size = 2

[*.{kt,kts}]
ktlint_code_style = ktlint_official
# Compose naming (PascalCase @Composable functions) is the Android convention.
ktlint_function_naming_ignore_when_annotated_with = Composable
max_line_length = 140
